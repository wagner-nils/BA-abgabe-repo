# Copy to .env and fill in. The pipeline reads .env from the repository root (tools/pipeline/run_extract.py, load_dotenv).

# Amazon Bedrock API key (bearer token). The AWS SDKs read this exact variable name.
AWS_BEARER_TOKEN_BEDROCK=

# Region the Bedrock calls go to (the registered run used eu-central-1; the region of a run is the instrument's).
AWS_REGION=eu-central-1

# Inception API key: only for the Mercury 3 comparison (specification §4g), not for the registered pipeline.
INCEPTION_API_KEY=
